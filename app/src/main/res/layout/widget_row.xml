<?xml version="1.0" encoding="utf-8"?>
<!-- Media buttons with no background of their own; each fills its share so taps land easily. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/widget_previous"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_previous"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_previous" />

    <ImageView
        android:id="@+id/widget_play_pause"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_play_pause"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_play_pause" />

    <ImageView
        android:id="@+id/widget_next"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_margin="2dp"
        android:layout_weight="1"
        android:contentDescription="@string/widget_next"
        android:padding="10dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_widget_next" />
</LinearLayout>
